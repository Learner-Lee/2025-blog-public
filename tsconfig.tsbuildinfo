; }; }' to type '{ artCard: { width: number; height: number; order: number; offsetX: null; offsetY: null; enabled: boolean; }; hiCard: { width: number; height: number; order: number; offsetX: null; offsetY: null; enabled: boolean; }; ... 10 more ...; beianCard: { ...; }; }' may be a mistake because neither type sufficiently overlaps with the other. If this was intentional, convert the expression to 'unknown' first.","category":1,"code":2352,"next":[{"messageText":"The types of '\"hatCard\"[\"offsetX\"]' are incompatible between these types.","category":1,"code":2200,"next":[{"messageText":"Type 'null' is not comparable to type 'number'.","category":1,"code":2678,"canonicalHead":{"code":2678,"messageText":"Type '{ width: number; height: number; order: number; offsetX: null; offsetY: null; enabled: boolean; }' is not comparable to type '{ width: number; height: number; order: number; offsetX: number; offsetY: number; enabled: boolean; }'."}}]}]}}]],[859,[{"start":1326,"length":5,"messageText":"Cannot find name 'toast'.","category":1,"code":2304}]]],"affectedFilesPendingEmit":[866,520,776,777,778,779,780,791,793,794,537,538,550,535,549,551,536,548,525,781,782,769,784,796,552,787,785,534,553,788,824,823,826,557,558,559,834,828,829,561,562,523,563,567,835,568,837,569,570,838,571,839,572,775,840,841,573,576,577,581,582,842,556,583,844,843,584,585,846,586,587,845,848,588,847,524,850,589,851,862,859,852,858,860,853,856,855,857,854,593,596,600,861,595,594,601,592,590,832,831,830,768,821,789,790,555,566,783,833,820,772,770,580,771,547,564,863,521,579,608,609,575,822,616,565,767,795,617,864,774,865,773,618,578,560,619,528,732,591,526,733,765,541,766],"version":"5.9.3"}